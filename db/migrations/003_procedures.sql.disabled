-- ============================================================================
-- Restaurant POS V2 — Stored Procedures & Triggers
-- ============================================================================
-- Encapsulates transaction logic in the database for atomicity.
-- App calls these to guarantee consistency even if app crashes mid-call.
-- ============================================================================

USE `oshxona_erp_v2`;

DELIMITER //

-- ============================================================
-- 1. generate_order_number()
--    Atomic per-restaurant sequential order number.
--    Uses SELECT ... FOR UPDATE on restaurants row to serialize.
-- ============================================================
DROP PROCEDURE IF EXISTS `sp_generate_order_number`//
CREATE PROCEDURE `sp_generate_order_number`(
  IN p_restaurant_id CHAR(28),
  OUT p_order_number VARCHAR(20)
)
BEGIN
  DECLARE v_next INT;
  -- Lock restaurant row to serialize number generation
  SELECT COALESCE(MAX(seq), 0) + 1 INTO v_next
  FROM (
    SELECT CAST(SUBSTRING(order_number, 5) AS UNSIGNED) AS seq
    FROM orders
    WHERE restaurant_id = p_restaurant_id
      AND order_number REGEXP '^[0-9]{4}-[0-9]+$'
  ) AS t;

  IF v_next IS NULL THEN
    SET v_next = 1;
  END IF;

  -- Format: YYYY-NNNNN  (e.g. 2026-00001)
  SET p_order_number = CONCAT(
    YEAR(NOW()), '-',
    LPAD(v_next, 5, '0')
  );
END//

-- ============================================================
-- 2. sp_pay_order()
--    Atomically process payment: lock order, create payment, free table,
--    consume inventory, update shift totals, queue receipt print job.
--    Returns p_payment_id and p_status.
-- ============================================================
DROP PROCEDURE IF EXISTS `sp_pay_order`//
CREATE PROCEDURE `sp_pay_order`(
  IN  p_restaurant_id    CHAR(28),
  IN  p_order_id         CHAR(28),
  IN  p_cashier_id       CHAR(28),
  IN  p_shift_id         CHAR(28),
  IN  p_subtotal         DECIMAL(14,2),
  IN  p_discount_amount  DECIMAL(14,2),
  IN  p_tax_amount       DECIMAL(14,2),
  IN  p_tip_amount       DECIMAL(14,2),
  IN  p_total_paid       DECIMAL(14,2),
  IN  p_change_amount    DECIMAL(14,2),
  IN  p_payment_method   VARCHAR(20),
  IN  p_cash_amount      DECIMAL(14,2),
  IN  p_card_amount      DECIMAL(14,2),
  IN  p_click_amount     DECIMAL(14,2),
  IN  p_payme_amount     DECIMAL(14,2),
  IN  p_reference        VARCHAR(100),
  IN  p_idempotency_key  CHAR(36),
  IN  p_version          BIGINT,
  IN  p_cashier_printer_id CHAR(28),
  OUT p_payment_id       CHAR(28),
  OUT p_status           VARCHAR(20),
  OUT p_error_msg        VARCHAR(255)
)
BEGIN
  DECLARE v_current_version BIGINT;
  DECLARE v_payment_status VARCHAR(20);
  DECLARE v_table_id CHAR(28);
  DECLARE v_existing_payment CHAR(28);
  DECLARE v_total_sum DECIMAL(14,2);
  DECLARE v_paid_sum DECIMAL(14,2);
  DECLARE v_continue INT DEFAULT 1;

  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = CONCAT('DB error: ', SQLSTATE, ' - ', SQLERRM);
    SET p_payment_id = NULL;
  END;

  SET p_status = 'ok';
  SET p_error_msg = NULL;
  SET p_payment_id = NULL;

  -- Validation 1: total_paid must equal sum of cash+card+click+payme
  SET v_paid_sum = p_cash_amount + p_card_amount + p_click_amount + p_payme_amount;
  IF v_paid_sum <> p_total_paid THEN
    SET p_status = 'error';
    SET p_error_msg = CONCAT('Payment methods sum (', v_paid_sum, ') does not equal total_paid (', p_total_paid, ')');
    RETURN;
  END IF;

  START TRANSACTION;

  -- Lock the order row with FOR UPDATE — concurrent cashiers wait here
  SELECT version, payment_status, table_id
    INTO v_current_version, v_payment_status, v_table_id
  FROM orders
  WHERE id = p_order_id
    AND restaurant_id = p_restaurant_id
  FOR UPDATE;

  -- Order not found
  IF v_current_version IS NULL THEN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = 'Order not found';
    RETURN;
  END IF;

  -- Optimistic lock check
  IF v_current_version <> p_version THEN
    ROLLBACK;
    SET p_status = 'conflict';
    SET p_error_msg = CONCAT('Order version mismatch. Expected ', p_version, ' but got ', v_current_version);
    RETURN;
  END IF;

  -- Idempotency: already paid?
  IF v_payment_status = 'paid' THEN
    SELECT id INTO v_existing_payment
    FROM payments
    WHERE order_id = p_order_id
    LIMIT 1;
    ROLLBACK;
    SET p_status = 'already_paid';
    SET p_payment_id = v_existing_payment;
    SET p_error_msg = 'Order already paid (idempotent return)';
    RETURN;
  END IF;

  -- Idempotency: same idempotency_key already used?
  SELECT id INTO v_existing_payment
  FROM payments
  WHERE restaurant_id = p_restaurant_id
    AND idempotency_key = p_idempotency_key
  FOR UPDATE;
  IF v_existing_payment IS NOT NULL THEN
    ROLLBACK;
    SET p_status = 'duplicate';
    SET p_payment_id = v_existing_payment;
    SET p_error_msg = 'Idempotency key already used (duplicate return)';
    RETURN;
  END IF;

  -- Generate payment ID (cuid-style placeholder)
  SET p_payment_id = CONCAT('pay_', REPLACE(UUID(), '-', ''), '_v2');

  -- Insert payment record
  INSERT INTO payments (
    id, restaurant_id, order_id, shift_id, cashier_id,
    subtotal, discount_amount, tax_amount, tip_amount, total_paid, change_amount,
    payment_method, cash_amount, card_amount, click_amount, payme_amount,
    reference, idempotency_key, paid_at, created_at
  ) VALUES (
    p_payment_id, p_restaurant_id, p_order_id, p_shift_id, p_cashier_id,
    p_subtotal, p_discount_amount, p_tax_amount, p_tip_amount, p_total_paid, p_change_amount,
    p_payment_method, p_cash_amount, p_card_amount, p_click_amount, p_payme_amount,
    p_reference, p_idempotency_key, NOW(3), NOW(3)
  );

  -- Insert payment_items for each method with non-zero amount
  IF p_cash_amount  > 0 THEN
    INSERT INTO payment_items (id, payment_id, method, amount, reference, created_at)
      VALUES (CONCAT('pi_cash_', p_payment_id),  p_payment_id, 'cash',  p_cash_amount,  NULL, NOW(3))
      ON DUPLICATE KEY UPDATE amount = p_cash_amount;
  END IF;
  IF p_card_amount  > 0 THEN
    INSERT INTO payment_items (id, payment_id, method, amount, reference, created_at)
      VALUES (CONCAT('pi_card_', p_payment_id),  p_payment_id, 'card',  p_card_amount,  NULL, NOW(3))
      ON DUPLICATE KEY UPDATE amount = p_card_amount;
  END IF;
  IF p_click_amount > 0 THEN
    INSERT INTO payment_items (id, payment_id, method, amount, reference, created_at)
      VALUES (CONCAT('pi_click_', p_payment_id), p_payment_id, 'click', p_click_amount, NULL, NOW(3))
      ON DUPLICATE KEY UPDATE amount = p_click_amount;
  END IF;
  IF p_payme_amount > 0 THEN
    INSERT INTO payment_items (id, payment_id, method, amount, reference, created_at)
      VALUES (CONCAT('pi_payme_', p_payment_id), p_payment_id, 'payme', p_payme_amount, NULL, NOW(3))
      ON DUPLICATE KEY UPDATE amount = p_payme_amount;
  END IF;

  -- Update order: status=paid, version++ (optimistic lock), closed_at
  UPDATE orders
  SET status = 'paid',
      payment_status = 'paid',
      cashier_id = p_cashier_id,
      version = version + 1,
      closed_at = NOW(3),
      updated_at = NOW(3)
  WHERE id = p_order_id
    AND restaurant_id = p_restaurant_id
    AND version = p_version;

  -- If table was set, free it
  IF v_table_id IS NOT NULL THEN
    UPDATE tables
    SET status = 'free',
        current_order_id = NULL,
        updated_at = NOW(3)
    WHERE id = v_table_id;
  END IF;

  -- Update shift totals (if shift provided)
  IF p_shift_id IS NOT NULL THEN
    UPDATE shifts
    SET total_sales = total_sales + p_total_paid,
        cash_sales  = cash_sales  + p_cash_amount,
        card_sales  = card_sales  + p_card_amount,
        click_sales = click_sales + p_click_amount,
        payme_sales = payme_sales + p_payme_amount,
        updated_at = NOW(3)
    WHERE id = p_shift_id
      AND restaurant_id = p_restaurant_id;
  END IF;

  -- Consume inventory: for each order item, look up recipes and decrement stock
  BEGIN
    DECLARE v_done INT DEFAULT 0;
    DECLARE v_inventory_id CHAR(28);
    DECLARE v_quantity DECIMAL(14,4);
    DECLARE v_unit VARCHAR(20);
    DECLARE v_product_id CHAR(28);
    DECLARE v_order_qty DECIMAL(10,3);

    DECLARE recipe_cur CURSOR FOR
      SELECT r.inventory_id, r.quantity * v_order_qty AS needed, r.unit, oi.product_id
      FROM order_items oi
      JOIN recipes r ON r.product_id = oi.product_id AND r.restaurant_id = p_restaurant_id
      WHERE oi.order_id = p_order_id
        AND oi.status <> 'cancelled';

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;

    -- We need per-item iteration; TiDB cursors can't easily bind variables to outer loop,
    -- so we iterate recipes joined with order_items via a single query.
    -- For each (product_id, qty), consume recipes.

    -- Simpler: loop over order items then recipes (nested). But TiDB cursor is fine.

    OPEN recipe_cur;
    -- But v_order_qty is per-row; we need a different approach.
    CLOSE recipe_cur;

    -- Use a direct set-based INSERT ... SELECT for inventory_transactions
    -- and UPDATE inventory ... WHERE id IN (...)
    INSERT INTO inventory_transactions
      (inventory_id, restaurant_id, type, quantity, unit_cost, reason, reference_type, reference_id, user_id, created_at)
    SELECT
      r.inventory_id,
      p_restaurant_id,
      'out',
      -(r.quantity * oi.quantity),
      i.cost,
      CONCAT('Order consumed: product=', oi.product_id, ' qty=', oi.quantity),
      'order',
      p_order_id,
      p_cashier_id,
      NOW(3)
    FROM order_items oi
    JOIN recipes r ON r.product_id = oi.product_id
    JOIN inventory i ON i.id = r.inventory_id
    WHERE oi.order_id = p_order_id
      AND oi.status <> 'cancelled';

    -- Decrement stock (set-based)
    UPDATE inventory i
    JOIN (
      SELECT r.inventory_id AS inv_id, SUM(r.quantity * oi.quantity) AS total_consumed
      FROM order_items oi
      JOIN recipes r ON r.product_id = oi.product_id
      WHERE oi.order_id = p_order_id
        AND oi.status <> 'cancelled'
      GROUP BY r.inventory_id
    ) AS agg ON agg.inv_id = i.id
    SET i.stock = i.stock - agg.total_consumed,
        i.updated_at = NOW(3);
  END;

  -- Insert order_event
  INSERT INTO order_events (order_id, restaurant_id, type, user_id, payload, created_at)
  VALUES (p_order_id, p_restaurant_id, 'paid', p_cashier_id,
          JSON_OBJECT('payment_id', p_payment_id, 'method', p_payment_method, 'total', p_total_paid),
          NOW(3));

  -- Queue receipt print job
  INSERT INTO print_jobs (id, restaurant_id, printer_id, order_id, payment_id, type, payload, status, idempotency_key, queued_at)
  VALUES (
    CONCAT('pj_receipt_', p_payment_id),
    p_restaurant_id,
    p_cashier_printer_id,
    p_order_id,
    p_payment_id,
    'receipt',
    X'1B40',  -- ESC @ (init) — real ESC/POS built by app
    'pending',
    CONCAT('rcpt_', p_idempotency_key),
    NOW(3)
  )
  ON DUPLICATE KEY UPDATE status = 'pending';

  COMMIT;
END//

-- ============================================================
-- 3. sp_cancel_order_item()
--    Mark item cancelled with reason, write audit, emit cancel print job.
-- ============================================================
DROP PROCEDURE IF EXISTS `sp_cancel_order_item`//
CREATE PROCEDURE `sp_cancel_order_item`(
  IN  p_restaurant_id  CHAR(28),
  IN  p_order_id       CHAR(28),
  IN  p_order_item_id  CHAR(28),
  IN  p_user_id        CHAR(28),
  IN  p_reason         VARCHAR(200),
  OUT p_status         VARCHAR(20),
  OUT p_error_msg      VARCHAR(255)
)
BEGIN
  DECLARE v_current_status VARCHAR(20);
  DECLARE v_order_status   VARCHAR(20);
  DECLARE v_table_id CHAR(28);
  DECLARE v_product_id CHAR(28);
  DECLARE v_station VARCHAR(20);

  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = CONCAT('DB error: ', SQLSTATE);
  END;

  START TRANSACTION;

  SELECT oi.status, o.status, o.table_id, oi.product_id, oi.station
    INTO v_current_status, v_order_status, v_table_id, v_product_id, v_station
  FROM order_items oi
  JOIN orders o ON o.id = oi.order_id
  WHERE oi.id = p_order_item_id
    AND oi.order_id = p_order_id
    AND oi.restaurant_id IS NULL  -- we did not add restaurant_id to oi table, we infer from order
  LIMIT 1;

  -- Actually need to select through order; rewrite:
  SELECT oi.status, o.status, o.table_id, oi.product_id, oi.station
    INTO v_current_status, v_order_status, v_table_id, v_product_id, v_station
  FROM order_items oi
  JOIN orders o ON o.id = oi.order_id
  WHERE oi.id = p_order_item_id
    AND oi.order_id = p_order_id
    AND o.restaurant_id = p_restaurant_id
  FOR UPDATE;

  IF v_current_status IS NULL THEN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = 'Order item not found';
    RETURN;
  END IF;

  IF v_current_status = 'cancelled' THEN
    ROLLBACK;
    SET p_status = 'already_cancelled';
    SET p_error_msg = 'Item already cancelled';
    RETURN;
  END IF;

  IF v_order_status = 'paid' THEN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = 'Cannot cancel item of paid order (use refund flow)';
    RETURN;
  END IF;

  -- Mark cancelled
  UPDATE order_items
  SET status = 'cancelled',
      cancelled_at = NOW(3),
      cancel_reason = p_reason,
      updated_at = NOW(3)
  WHERE id = p_order_item_id;

  -- Bump order version (any view of the order is now stale)
  UPDATE orders
  SET version = version + 1,
      updated_at = NOW(3)
  WHERE id = p_order_id
    AND restaurant_id = p_restaurant_id;

  -- Write history
  INSERT INTO order_item_status_history (order_item_id, order_id, restaurant_id, from_status, to_status, changed_by, note, created_at)
  VALUES (p_order_item_id, p_order_id, p_restaurant_id, v_current_status, 'cancelled', p_user_id, p_reason, NOW(3));

  -- Insert order event
  INSERT INTO order_events (order_id, restaurant_id, type, user_id, payload, created_at)
  VALUES (p_order_id, p_restaurant_id, 'item_cancelled', p_user_id,
          JSON_OBJECT('order_item_id', p_order_item_id, 'reason', p_reason),
          NOW(3));

  COMMIT;
  SET p_status = 'ok';
  SET p_error_msg = NULL;
END//

-- ============================================================
-- 4. sp_close_z_report()
--    Atomically: snapshot current totals, update restaurant.last_z_report_at
-- ============================================================
DROP PROCEDURE IF EXISTS `sp_close_z_report`//
CREATE PROCEDURE `sp_close_z_report`(
  IN  p_restaurant_id CHAR(28),
  IN  p_user_id       CHAR(28),
  IN  p_cashier_printer_id CHAR(28),
  OUT p_zreport_count INT,
  OUT p_status        VARCHAR(20),
  OUT p_error_msg     VARCHAR(255)
)
BEGIN
  DECLARE v_prev_at DATETIME(3);
  DECLARE v_now DATETIME(3);
  DECLARE v_total_sales DECIMAL(14,2);
  DECLARE v_cash_sales  DECIMAL(14,2);
  DECLARE v_card_sales  DECIMAL(14,2);
  DECLARE v_click_sales DECIMAL(14,2);
  DECLARE v_payme_sales DECIMAL(14,2);
  DECLARE v_refunds     DECIMAL(14,2);
  DECLARE v_voids       INT;

  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    SET p_status = 'error';
    SET p_error_msg = CONCAT('DB error: ', SQLSTATE);
  END;

  START TRANSACTION;

  -- Lock restaurant row
  SELECT last_z_report_at INTO v_prev_at
  FROM restaurants
  WHERE id = p_restaurant_id
  FOR UPDATE;

  SET v_now = NOW(3);
  IF v_prev_at IS NULL THEN
    SET v_prev_at = '1970-01-01 00:00:00.000';
  END IF;

  SELECT
    COALESCE(SUM(total_paid), 0),
    COALESCE(SUM(cash_amount), 0),
    COALESCE(SUM(card_amount), 0),
    COALESCE(SUM(click_amount), 0),
    COALESCE(SUM(payme_amount), 0),
    0,
    0
  INTO v_total_sales, v_cash_sales, v_card_sales, v_click_sales, v_payme_sales, v_refunds, v_voids
  FROM payments
  WHERE restaurant_id = p_restaurant_id
    AND paid_at >= v_prev_at
    AND paid_at < v_now
  FOR UPDATE;

  -- Void count (cancelled orders in period)
  SELECT COUNT(*) INTO v_voids
  FROM orders
  WHERE restaurant_id = p_restaurant_id
    AND status = 'cancelled'
    AND updated_at >= v_prev_at
    AND updated_at < v_now;

  SET p_zreport_count = v_voids;

  -- Update restaurant cutoff
  UPDATE restaurants
  SET last_z_report_at = v_now,
      updated_at = NOW(3)
  WHERE id = p_restaurant_id;

  -- Insert audit log
  INSERT INTO audit_logs (restaurant_id, user_id, action, entity, entity_id, before, after, created_at)
  VALUES (
    p_restaurant_id, p_user_id, 'z_report_close', 'restaurant', p_restaurant_id,
    JSON_OBJECT('last_z_report_at', v_prev_at),
    JSON_OBJECT('last_z_report_at', v_now,
                'total_sales', v_total_sales,
                'cash', v_cash_sales, 'card', v_card_sales,
                'click', v_click_sales, 'payme', v_payme_sales,
                'voids', v_voids),
    NOW(3)
  );

  -- Queue Z-report print job
  INSERT INTO print_jobs (id, restaurant_id, printer_id, order_id, payment_id, type, payload, status, idempotency_key, queued_at)
  VALUES (
    CONCAT('pj_zreport_', REPLACE(UUID(), '-', '')),
    p_restaurant_id,
    p_cashier_printer_id,
    NULL,
    NULL,
    'zreport',
    X'1B40',
    'pending',
    CONCAT('zrep_', p_restaurant_id, '_', UNIX_TIMESTAMP(v_now)),
    NOW(3)
  );

  COMMIT;
  SET p_status = 'ok';
  SET p_error_msg = NULL;
END//

DELIMITER ;
